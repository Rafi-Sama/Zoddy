{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zoddy/zoddy",
    "type": "project",
    "description": "Zoddy Multi-Tenant SocialERP Platform.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "*",
        "laravel/tinker": "^2.10.1",
        "laravel/wayfinder": "^0.1.11",
        "stancl/tenancy": "^3.9",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/tenants.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "lint": [
            "pint --parallel"
        ],
        "test:lint": [
            "pint --parallel --test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@test:lint",
            "@php artisan test --parallel"
        ],
        "ci": [
            "@test:lint",
            "@analyse",
            "@test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[1/7] PHP Code Style (Pint)' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "@test:lint",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[2/7] Static Analysis (PHPStan)' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "@analyse",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[3/7] PHP Tests (Pest)' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "@php artisan config:clear --ansi",
            "./vendor/bin/pest",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[4/7] Frontend Format Check (Prettier)' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "npm run format:check",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[5/7] Frontend Lint Check (ESLint)' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "npm run lint:check",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[6/7] TypeScript Type Check' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "npm run types",
            "@php -r \"echo str_repeat('-', 50) . PHP_EOL . '[7/7] Frontend Build' . PHP_EOL . str_repeat('-', 50) . PHP_EOL;\"",
            "npm run build",
            "@php -r \"echo PHP_EOL . str_repeat('=', 50) . PHP_EOL . 'All checks passed. Safe to push!' . PHP_EOL . str_repeat('=', 50) . PHP_EOL;\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}